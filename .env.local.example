# 复制为 .env.local 后填入你的 Supabase 项目信息（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 仅在部署到 GitHub Pages 时需要：填你的仓库名，例如仓库是 github.com/you/couple-ledger 则填 couple-ledger
# 部署到 Vercel / Cloudflare Pages 时留空
NEXT_PUBLIC_BASE_PATH=

# 可选：给网页加一道简单的访问码软门槛（不是真正的账号登录）。
# 留空则完全不设防，任何拿到网址的人都能直接使用。
NEXT_PUBLIC_ACCESS_CODE=
